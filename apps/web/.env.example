# apps/web/.env.example — public website
#
# Copy to .env for local development. Never commit .env.
# In deployment these are set as Cloudflare Pages environment variables.
#
# NUXT_PUBLIC_ variables are inlined into the browser bundle by design — put
# nothing secret here.

# API origin. Read by nuxt.config.ts → runtimeConfig.public.apiBase.
# Defaults to the Railway production URL when unset.
# Local: http://localhost:8000
NUXT_PUBLIC_API_BASE=https://churchos-production-c6ae.up.railway.app
