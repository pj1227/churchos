# apps/admin/.env.example — staff admin dashboard
#
# Copy to .env for local development. Never commit .env.
# In deployment these are set as Cloudflare Pages environment variables.
#
# NUXT_PUBLIC_ variables are inlined into the browser bundle by design. The
# publishable key is meant to be public — RLS policies control what it can do.

# Read by nuxt.config.ts for both the @nuxtjs/supabase module and
# runtimeConfig.public.
NUXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Publishable key (formerly "anon"), not the secret key.
NUXT_PUBLIC_SUPABASE_ANON_KEY=
