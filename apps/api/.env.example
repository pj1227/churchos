# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=

# Database (direct connection for Alembic migrations)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=churchos-media

# AI providers
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_TRADITION=evangelical
GLOO_PUBLISHER=
ANTHROPIC_API_KEY=

# App
CHURCH_SLUG=libby-naz
CHURCH_NAME=Libby Church of the Nazarene
ENVIRONMENT=development
