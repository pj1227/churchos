# Supabase
SUPABASE_URL=https://your-project.supabase.co
# Publishable key (formerly anon) — safe to use server-side for public queries
SUPABASE_PUBLISHABLE_KEY=
# Secret key (formerly service_role) — bypasses RLS, server only, never expose to browser
SUPABASE_SECRET_KEY=
# JWT signing key — used by FastAPI to verify tokens without a Supabase round-trip
SUPABASE_JWT_SECRET=

# Database (direct connection for Alembic migrations — use the non-pooled URI)
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# Redis (Upstash)
REDIS_URL=rediss://default:password@your-instance.upstash.io:6379

# Backblaze B2
B2_KEY_ID=
B2_APPLICATION_KEY=
B2_BUCKET_NAME=churchos-media

# AI providers
GLOO_CLIENT_ID=
GLOO_CLIENT_SECRET=
GLOO_TRADITION=evangelical
GLOO_PUBLISHER=
ANTHROPIC_API_KEY=

# App
CHURCH_SLUG=libby-naz
CHURCH_NAME=Libby Church of the Nazarene
ENVIRONMENT=development
