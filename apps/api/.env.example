# apps/api/.env.example
#
# Copy to .env for local development. Never commit .env.
# In deployment these are set as Railway environment variables.
#
# Every variable below is read by app/config.py (pydantic-settings), except
# DATABASE_URL, which is read directly by alembic/env.py.
# Naming note (Supabase, 2025): "publishable" = old anon key, "secret" = old
# service_role key.

# ── Supabase (required) ──────────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
# Secret key — bypasses RLS. Server only, never expose to a browser.
SUPABASE_SERVICE_KEY=
# JWT signing key (Settings → API → JWT Settings). Verifies HS256 access
# tokens without a Supabase round-trip.
SUPABASE_JWT_SECRET=

# ── App (required) ───────────────────────────────────────────────────────────
# Id of the singleton row in public.churches. Always "default" — ChurchOS is
# single-tenant per deployment.
CHURCH_ID=default
CHURCH_SLUG=libby-naz

# ── Database — migrations only ───────────────────────────────────────────────
# Read by alembic/env.py for `alembic upgrade head`. Use the non-pooled URI.
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Redis (Upstash) — rate limiting ──────────────────────────────────────────
# Optional. Blank disables rate limiting (fail-open).
UPSTASH_REDIS_URL=rediss://your-instance.upstash.io:6380
UPSTASH_REDIS_TOKEN=

# ── AI — prayer board moderation ─────────────────────────────────────────────
# Optional. Blank means submissions are approved (fail-open).
# The active provider and the Gloo credentials live in the site_config table
# and are edited in admin Settings → AI Moderation, not here.
GROK_API_KEY=
# Declared in config.py but not currently used by any code path.
ANTHROPIC_API_KEY=

# ── Email — default SMTP connector ───────────────────────────────────────────
# Optional. Blank disables outbound email. MS365 credentials live in
# site_config, not here.
# MS365: smtp.office365.com:587 · Gmail: smtp.gmail.com:587
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_NAME=ChurchOS
